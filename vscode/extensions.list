# vscode/extensions.list — Dotfiles Citadel
# Managed by: https://github.com/geekedsilicon/dotfiles
#
# Manifest of VS Code extensions for the Zenith dev environment.
# Install all at once:
#   cat vscode/extensions.list | grep -v '^#' | grep -v '^$' \
#     | xargs -L1 code --install-extension
#
# Or in PowerShell:
#   Get-Content vscode\extensions.list |
#     Where-Object { $_ -notmatch '^#' -and $_.Trim() -ne '' } |
#     ForEach-Object { code --install-extension $_ }

