{
  // =========================================================================
  // VS Code settings.json — Dotfiles Citadel
  // Managed by: https://github.com/geekedsilicon/dotfiles
  // Symlinked to:
  //   Windows : %APPDATA%\Code\User\settings.json
  //   WSL/Linux: ~/.config/Code/User/settings.json
  //
  // Tuned for AMD Ryzen AI 7 / 16 GB RAM — stability over raw throughput.
  // =========================================================================

  // ---------------------------------------------------------------------------
  // Editor
  // ---------------------------------------------------------------------------
  "editor.fontFamily": "'Cascadia Code', 'FiraCode Nerd Font', Consolas, monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.lineHeight": 1.6,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.minimap.enabled": false,
  "editor.largeFileOptimizations": true,

  // ---------------------------------------------------------------------------
  // File watching — exclude heavy directories to reduce I/O pressure
  // ---------------------------------------------------------------------------
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.next/**": true,
    "**/target/**": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/node_modules": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.next": true
  },
  "search.followSymlinks": false,
  "files.maxMemoryForLargeFilesMB": 256,

  // ---------------------------------------------------------------------------
  // Memory / performance guards
  // ---------------------------------------------------------------------------
  "extensions.autoUpdate": false,
  "telemetry.telemetryLevel": "off",
  "window.restoreWindows": "none",
  "git.autofetch": false,
  "git.decorations.enabled": true,

  // ---------------------------------------------------------------------------
  // Terminal — use WSL2 as default integrated shell
  // ---------------------------------------------------------------------------
  "terminal.integrated.defaultProfile.windows": "Ubuntu (WSL)",
  "terminal.integrated.profiles.windows": {
    "Ubuntu (WSL)": {
      "path": "wsl.exe",
      "args": ["-d", "Ubuntu"],
      "icon": "terminal-ubuntu"
    },
    "PowerShell": {
      "source": "PowerShell",
      "icon": "terminal-powershell"
    }
  },
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.scrollback": 5000,

  // ---------------------------------------------------------------------------
  // WSL remote
  // ---------------------------------------------------------------------------
  "remote.WSL.useShellEnvironment": true,

  // ---------------------------------------------------------------------------
  // Workbench
  // ---------------------------------------------------------------------------
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.startupEditor": "none",
  "workbench.tree.indent": 16
}
